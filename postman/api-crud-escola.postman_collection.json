{
  "info": {
    "_postman_id": "7f2c5d90-4c6d-4d26-9db0-api-crud-escola",
    "name": "API CRUD Escola",
    "description": "Collection didática para testar as rotas CRUD de alunos. Antes de executar, inicie a API Node.js e confira a variável baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "alunoId",
      "value": "COLE_O_ID_RETORNADO_AQUI",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Alunos",
      "item": [
        {
          "name": "Listar alunos — GET",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alunos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alunos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Resposta é JSON', function () {",
                  "    pm.response.to.be.json;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar aluno — POST",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Teste\",\n  \"matricula\": \"POSTMAN-1001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/alunos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alunos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status é 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const dados = pm.response.json();",
                  "if (dados._id) {",
                  "    pm.collectionVariables.set('alunoId', dados._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Localizar aluno por _id — GET",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alunos/{{alunoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alunos", "{{alunoId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar aluno por _id — PUT",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Atualizada\",\n  \"matricula\": \"POSTMAN-1001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/alunos/{{alunoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alunos", "{{alunoId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir aluno por _id — DELETE",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alunos/{{alunoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alunos", "{{alunoId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status é 204 ou 200', function () {",
                  "    pm.expect([200, 204]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
